340\271\211\340\270\262\340\270\210\340\270\255\340\270\253\340\270\245\340\270\261\340\270\201\" (Add to Home screen)**\n- **\340\270\204\340\270\255\340\270\241\340\270\236\340\270\264\340\270\247\340\271\200\340\270\225\340\270\255\340\270\243\340\271\214 (Chrome/Edge)**: \340\270\224\340\271\211\340\270\262\340\270\231\340\270\202\340\270\247\340\270\262\340\270\202\340\270\255\340\270\207\340\271\201\340\270\226\340\270\232\340\270\212\340\271\210\340\270\255\340\270\207\340\271\203\340\270\252\340\271\210 URL \340\270\224\340\271\211\340\270\262\340\270\231\340\270\232\340\270\231 \340\270\210\340\270\260\340\270\241\340\270\265\340\271\204\340\270\255\340\270\204\340\270\255\340\270\231\340\270\253\340\270\231\340\271\211\340\270\262\340\270\210\340\270\255\340\271\200\340\270\245\340\271\207\340\270\201\340\271\206 \340\270\233\340\270\243\340\270\262\340\270\201\340\270\217\340\270\202\340\270\266\340\271\211\340\270\231\340\270\241\340\270\262 (\340\270\253\340\270\243\340\270\267\340\270\255\340\270\210\340\270\270\340\270\224 3 \340\270\210\340\270\270\340\270\224) \340\271\203\340\270\253\340\271\211\340\270\201\340\270\224\340\271\200\340\270\236\340\270\267\340\271\210\340\270\255\340\270\227\340\270\263\340\270\201\340\270\262\340\270\243\340\270\225\340\270\264\340\270\224\340\270\225\340\270\261\340\271\211\340\270\207 \340\271\201\340\270\245\340\271\211\340\270\247\340\271\201\340\270\255\340\270\233\340\270\210\340\270\260\340\271\201\340\270\242\340\270\201\340\271\200\340\270\202\340\271\211\340\270\262\340\271\204\340\270\233\340\270\255\340\270\242\340\270\271\340\271\210\340\271\200\340\270\253\340\270\241\340\270\267\340\270\255\340\270\231\340\271\202\340\270\233\340\270\243\340\271\201\340\270\201\340\270\243\340\270\241\340\271\203\340\270\231\340\271\200\340\270\204\340\270\243\340\270\267\340\271\210\340\270\255\340\270\207\340\270\204\340\270\243\340\270\261\340\270\232 \340\271\204\340\270\241\340\271\210\340\270\233\340\270\260\340